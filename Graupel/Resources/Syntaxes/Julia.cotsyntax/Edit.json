{
  "characterDelimiters" : [
    {
      "begin" : "'",
      "end" : "'",
      "escapeCharacter" : "\\"
    }
  ],
  "comment" : {
    "blocks" : [
      {
        "begin" : "#=",
        "end" : "=#",
        "isNestable" : true
      }
    ],
    "inlines" : [
      {
        "begin" : "#"
      }
    ]
  },
  "indentation" : {
    "blockDelimiters" : [
      {
        "begin" : "begin",
        "end" : "end"
      },
      {
        "begin" : "try",
        "end" : "end"
      },
      {
        "begin" : "^\\s*(?!end\\b)(?:@\\w+\\s+)*(?:function|macro|module|baremodule|struct|mutable\\s+struct|abstract\\s+type|quote|let|if|for|while)\\b(?!.*\\bend\\s*$)",
        "description" : "blocks that start with a keyword, not one-line forms ending in end",
        "regularExpression" : true
      },
      {
        "begin" : "\\bdo(?:\\s+[\\w, ()]*)?\\s*(?:#.*)?$",
        "description" : "do blocks",
        "regularExpression" : true
      },
      {
        "begin" : "^\\s*(?:else|elseif\\b.*|catch\\b.*|finally)\\s*(?:#.*)?$",
        "description" : "else, elseif, catch, finally",
        "regularExpression" : true
      }
    ]
  },
  "stringDelimiters" : [
    {
      "begin" : "\"",
      "end" : "\"",
      "escapeCharacter" : "\\",
      "isMultiline" : true
    },
    {
      "begin" : "\"\"\"",
      "end" : "\"\"\"",
      "escapeCharacter" : "\\",
      "isMultiline" : true
    },
    {
      "begin" : "\"",
      "description" : "Prefixed string literal",
      "end" : "\"",
      "escapeCharacter" : "\\",
      "prefixes" : [
        "b",
        "r",
        "v"
      ]
    }
  ]
}