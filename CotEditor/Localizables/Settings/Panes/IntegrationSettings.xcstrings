    "Allow remote files to be opened in CotEditor using the `rmate` protocol." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über das Protokoll `rmate` können entfernte Dateien in CotEditor geöffnet werden."
          }
        },
        "en-GB" : {
          "stringUnit" : {
