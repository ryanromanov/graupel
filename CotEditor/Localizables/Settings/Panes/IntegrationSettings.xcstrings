        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая символическая ссылка `graupel` может указывать на недопустимый путь."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli `graupel` sembolik bağı, geçersiz bir yolu hedefleyebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточне символічне посилання `graupel` може вказувати на недійсний шлях."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前的`graupel`符号链接可能指向无效路径。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前的`graupel`符號鏈接可能指向無效路徑。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
