    "CommandLineToolManager.Status.differentTarget.message" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuální symbolický odkaz `graupel` neodkazuje na spuštěný Graupel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aktuelle symbolische Link `graupel` verweist nicht auf die laufende Version von Graupel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The current `graupel` symbolic link doesn’t target the running Graupel."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current `graupel` symbolic link doesn’t target the running Graupel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El enlace simbólico `graupel` actual no se dirige al Graupel en ejecución."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lien symbolique `graupel` actuel ne pointe pas vers la version de Graupel en cours d’exécution."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मौजूदा `graupel` सिंबॉलिक लिंक चल रहे Graupel को लक्षित नहीं करता।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il link simbolico `graupel` attuale non punta al Graupel in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在の`graupel`シンボリックリンクはこのGraupel以外に向けられています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 `graupel` 심볼릭 링크가 실행 중인 Graupel를 가리키지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De huidige `graupel` symbolische link richt zich niet op de actieve Graupel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obecne połączenie symboliczne `graupel` nie wskazuje działającego Graupela."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O link simbólico `graupel` atual não aponta para o Graupel em execução."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текущая символическая ссылка `graupel` не указывает на запущенный Graupel."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçerli `graupel` sembolik bağı, çalışan Graupel’ü hedeflemiyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поточне символічне посилання `graupel` не вказує на запущений Graupel."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前的`graupel`符号链接没有指向正在运行的Graupel。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當前的`graupel`符號鏈接沒有指向正在運行的Graupel。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現時`graupel`符號連結的目標不是正在執行的Graupel。"
          }
        }
      }
    },
