{
  "comment" : {
    "blocks" : [
      {
        "begin" : "%{",
        "end" : "%}"
      }
    ],
    "inlines" : [
      {
        "begin" : "%"
      }
    ]
  },
  "indentation" : {
    "blockDelimiters" : [
      {
        "begin" : "try",
        "end" : "end"
      },
      {
        "begin" : "properties",
        "end" : "end"
      },
      {
        "begin" : "methods",
        "end" : "end"
      },
      {
        "begin" : "events",
        "end" : "end"
      },
      {
        "begin" : "enumeration",
        "end" : "end"
      },
      {
        "begin" : "^\\s*(?:function|if|for|parfor|while|switch|case|otherwise|else|elseif|try|catch|classdef|spmd)\\b(?!.*[,;]\\s*end\\s*;?\\s*(?:%.*)?$)",
        "description" : "blocks, not one-line forms ending in end",
        "regularExpression" : true
      }
    ]
  },
  "stringDelimiters" : [
    {
      "begin" : "\"",
      "end" : "\"",
      "escapeCharacter" : "\""
    }
  ]
}